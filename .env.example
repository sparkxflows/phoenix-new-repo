# ============================================================================
# PHOENIX TATTOOZ — environment template
# Copy to .env for local work. On Vercel add the same names under
# Settings → Environment Variables (Production + Preview) and redeploy.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. BROWSER (Vite) — these are baked into the JS bundle at BUILD time
# ---------------------------------------------------------------------------
# true  = read/write content, bookings and reviews straight from Supabase
# false = stay on the app's own backend (Express locally, /api on Vercel)
VITE_USE_REMOTE_SUPABASE="true"

# Project URL + PUBLISHABLE (anon) key ONLY.
# NEVER put the service_role / secret key in a VITE_ variable — it ships to the browser.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# ---------------------------------------------------------------------------
# 2. SERVER (Vercel functions / Express) — never exposed to the browser
# ---------------------------------------------------------------------------
# Required for members, rewards, uploads, admin directory and CMS writes.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: signs member session tokens. Defaults to the service-role key.
# AUTH_TOKEN_SECRET="a-long-random-string"

# Optional: enables real Gemini answers in the chatbot. Without it the widget
# uses the built-in studio knowledge base (still fully functional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# 3. Local development only
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@phoenixtattooz.local"
ADMIN_PASSWORD="PhoenixClone2026!"
